### test endpoint
POST http://localhost:8080/v1/auth/test
accept: application/json
Content-Type: application/json

{
  "email": "111@asd.com",
  "password": "qwerty",
  "confirmPassword": "qwerty"
}

### register user
POST http://localhost:8080/v1/auth/registration
Content-Type: application/json

{
  "email": "111@asd.com",
  "password": "qwerty",
  "confirmPassword": "qwerty"
}

### login user
POST http://localhost:8080/v1/auth/login
Content-Type: application/json

{
  "email": "111@asd.com",
  "password": "qwerty",
  "confirmPassword": "qwerty"
}

### about me
GET http://localhost:8080/v1/auth/me
Content-Type: application/json
Authorization: Bearer {{token}}

### refresh token
POST http://localhost:8080/v1/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{token}}"
}